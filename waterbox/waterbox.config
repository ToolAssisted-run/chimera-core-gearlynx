{
  "coreName": "Gearlynx",
  "systemId": "LYNX",
  "systemNames": {
    "LYNX": "Atari Lynx"
  },
  "author": "Ignacio Sanchez (drhelius); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-gearlynx",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    4,
    16,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. Gearlynx keeps a 2 MB buffer for the cartridge (the largest it takes) and the Lynx has 64 KB of RAM.",
  "video": {
    "_comment": "The buffer's capacity: the Lynx's screen is 160x102, and 102x160 when Gearlynx turns the picture for a game held on its side (its header or upstream's list of games says so, or the Rotation setting). The live size comes from GetVideoWidth/Height. The frame rate is the program's own (timers 0 and 2): 1,000,000 / 16,695 is what the boot ROM sets, 59.9 frames a second; the core reports the live rate after every frame.",
    "width": 160,
    "height": 160,
    "vsyncNumerator": 1000000,
    "vsyncDenominator": 16695,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "Gearlynx mixes the four channels at 44,100 samples a second: 736 a frame at 59.9 frames a second, 588 at 75, 882 at 50.",
    "rate": 44100,
    "samplesPerFrame": 2048,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".lnx": "LYNX",
    ".lyx": "LYNX",
    ".o": "LYNX"
  },
  "input": {
    "name": "Atari Lynx Controls",
    "picture": "pictures/atari-lynx-ii.png",
    "_comment": "The Lynx's nine keys, and Power, which starts the console again (the cartridge's EEPROM keeps what it holds). Option 1 and Option 2 are the keys a game uses for its own things; Pause with Option 1 restarts most games and Pause with Option 2 turns the picture over for a left-handed player.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 Option 1",
      "P1 Option 2",
      "P1 Pause",
      "Power"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "Option 1": "1",
      "Option 2": "2",
      "Pause": "p",
      "Power": "P"
    },
    "headers": {
      "Option 1": "Opt1",
      "Option 2": "Opt2",
      "Pause": "Pause",
      "Power": "Pwr"
    },
    "players": [
      [
        "P1 Up",
        "P1 Down",
        "P1 Left",
        "P1 Right",
        "P1 A",
        "P1 B",
        "P1 Option 1",
        "P1 Option 2",
        "P1 Pause"
      ]
    ]
  },
  "settings": [
    {
      "name": "model",
      "display": "setting.model",
      "type": "enum",
      "options": [
        "auto",
        "lynx1",
        "lynx2"
      ],
      "optionLabels": [
        "setting.model.auto",
        "setting.model.lynx1",
        "setting.model.lynx2"
      ],
      "default": "auto",
      "description": "setting.model.about"
    },
    {
      "name": "rotation",
      "display": "setting.rotation",
      "type": "enum",
      "options": [
        "auto",
        "none",
        "left",
        "right",
        "180"
      ],
      "optionLabels": [
        "setting.rotation.auto",
        "setting.rotation.none",
        "setting.rotation.left",
        "setting.rotation.right",
        "setting.rotation.180"
      ],
      "default": "auto",
      "description": "setting.rotation.about"
    },
    {
      "name": "eeprom",
      "display": "setting.eeprom",
      "type": "enum",
      "options": [
        "auto",
        "none",
        "93c46_16",
        "93c46_8",
        "93c56_16",
        "93c56_8",
        "93c66_16",
        "93c66_8",
        "93c76_16",
        "93c76_8",
        "93c86_16",
        "93c86_8"
      ],
      "optionLabels": [
        "setting.eeprom.auto",
        "setting.eeprom.none",
        "setting.eeprom.93c46_16",
        "setting.eeprom.93c46_8",
        "setting.eeprom.93c56_16",
        "setting.eeprom.93c56_8",
        "setting.eeprom.93c66_16",
        "setting.eeprom.93c66_8",
        "setting.eeprom.93c76_16",
        "setting.eeprom.93c76_8",
        "setting.eeprom.93c86_16",
        "setting.eeprom.93c86_8"
      ],
      "default": "auto",
      "description": "setting.eeprom.about"
    },
    {
      "name": "fastSprites",
      "display": "setting.fastsprites",
      "type": "bool",
      "default": false,
      "description": "setting.fastsprites.about"
    },
    {
      "name": "randomSeed",
      "display": "setting.randomseed",
      "type": "uint",
      "default": 0,
      "min": 0,
      "max": 4294967295,
      "description": "setting.randomseed.about"
    }
  ],
  "_firmware_note": "The boot ROM: it decrypts a cartridge's loader, so every cartridge needs it. A BS93 program (.o), the format homebrew is sent to a Lynx in, is put in memory by Gearlynx without it. Dumps differ in the byte at 0x1F9, which is the memory map register's place and not the ROM's; Gearlynx writes its own value there, so a dump with another byte runs the same and is shown as not recognised.",
  "firmware": [
    {
      "id": "lynxboot.img",
      "display": "firmware.lynxboot_img",
      "description": "firmware.lynxboot_img.about",
      "size": 512,
      "sha1": "E4ED47FAE31693E016B081C6BDA48DA5B70D7CCB",
      "name": "lynxboot.img",
      "requiredWhen": {
        "not": {
          "slot": "game",
          "extension": "o"
        }
      }
    }
  ]
}
